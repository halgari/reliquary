{:paths ["src" "resources"]

 :deps {org.clojure/clojure                  {:mvn/version "1.12.5"}

        ;; UI
        cljfx/cljfx                          {:mvn/version "1.10.10"}
        org.openjfx/javafx-base$linux        {:mvn/version "26.0.2"}
        org.openjfx/javafx-graphics$linux    {:mvn/version "26.0.2"}
        org.openjfx/javafx-controls$linux    {:mvn/version "26.0.2"}

        ;; Steam
        com.google.protobuf/protobuf-java    {:mvn/version "4.35.1"}
        com.google.zxing/core                {:mvn/version "3.5.4"}
        org.tukaani/xz                       {:mvn/version "1.12"}
        ;; Zstandard, for the VSZ chunks Steam now serves. Pure Java on purpose,
        ;; the same reason org.tukaani/xz is: zstd-jni would put a native library
        ;; inside the jar, and this app ships as a jlink runtime built by jdeps.
        io.airlift/aircompressor              {:mvn/version "2.0.2"}

        ;; catalog
        org.clojure/data.json                {:mvn/version "2.5.2"}}

 :aliases
 {:test
  ;; tool/catalog is on the TEST path, not just :catalog-tool: verify_depots
  ;; writes license-denied-depots.json, which both fetch_versions.py and
  ;; assemble.py read to decide what ships in resources/catalog.edn. A mistake
  ;; there ends up in the shipped catalog as a version quietly missing base game
  ;; content, so it is exactly the kind of code that needs tests.
  {:extra-paths ["test" "test/resources" "tool/catalog"]
   :extra-deps  {io.github.cognitect-labs/test-runner
                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 org.clojure/test.check {:mvn/version "1.1.3"}}
   ;; reliquary.config-dir / reliquary.data-dir make the REAL
   ;; ~/.config/reliquary and ~/.local/share/reliquary unreachable from this
   ;; JVM at all, for every thread including ones no test fixture ever binds
   ;; -- catalog/refresh! writes its cache from a raw Thread, where a dynamic
   ;; `binding` in a test never applies. reliquary.test is the marker that
   ;; makes an ABSENT or later-cleared path property fail loudly instead of
   ;; silently falling through to the real path -- see
   ;; reliquary.config/prop-dir-or-die.
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "-Dreliquary.test=true"
                 "-Dreliquary.config-dir=target/test-state/config"
                 "-Dreliquary.data-dir=target/test-state/data"]
   :main-opts   ["-m" "cognitect.test-runner"]
   :exec-fn     cognitect.test-runner.api/test}

  :cli
  ;; --sun-misc-unsafe-memory-access=allow silences protobuf's four-line Unsafe
  ;; warning on every run; it is noise from a dependency, not from us, and it
  ;; would otherwise sit between the user and the QR code they need to scan.
  {:jvm-opts  ["--enable-native-access=ALL-UNNAMED"
               "--sun-misc-unsafe-memory-access=allow"]
   :main-opts ["-m" "reliquary.cli"]}

  :app
  {:jvm-opts  ["--enable-native-access=ALL-UNNAMED"
               "--sun-misc-unsafe-memory-access=allow"]
   :main-opts ["-m" "reliquary.main"]}

  ;; the catalog generator: needs a live Steam session to resolve the install
  ;; size of versions that community downgrade guides never published.
  :catalog-tool
  {:extra-paths ["tool/catalog"]
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"
                 "--sun-misc-unsafe-memory-access=allow"]}

  :dev
  {:extra-paths ["test" "test/resources"]
   :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]}

  :build
  {:extra-paths ["."]
   :extra-deps  {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
   :ns-default  build}}}
