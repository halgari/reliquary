                 {:text "Every player swears they'll be a mage this time. Most end up a stealth archer within the hour."
                  :attrib "every player, eventually"}
                 {:text "You will carry forty unenchanted iron daggers to sell later. You never sell them."
                  :attrib "every player, eventually"}]
