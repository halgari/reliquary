        {:appid 22330
         :title "The Elder Scrolls IV: Oblivion"
         :studio "Bethesda Game Studios"
         :art {:capsule "https://cdn.cloudflare.steamstatic.com/steam/apps/22330/library_600x900.jpg"
              :screenshots ["https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22330/0000009037.1920x1080.jpg"
                           "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/22330/0000009038.1920x1080.jpg"
